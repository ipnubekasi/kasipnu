# ====================================================================
# Kas IPNU · contoh variabel lingkungan. Salin menjadi .env.local (lokal)
# atau isi di Vercel: Project Settings > Environment Variables.
# JANGAN menaruh nilai rahasia di berkas yang di-commit.
# ====================================================================

# Wajib. Dashboard Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...). Aman untuk browser; akses tetap dibatasi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Alamat aplikasi setelah deploy, dipakai untuk tautan undangan dan atur ulang password.
NEXT_PUBLIC_SITE_URL=https://kas-ipnu.vercel.app

# Opsional, HANYA server. Secret key (sb_secret_...). Dipakai untuk:
#  - mengundang akun baru lewat email dari halaman Anggota;
#  - pemeriksaan terjadwal lewat Vercel Cron (alternatif pg_cron).
# Jangan pernah memberi awalan NEXT_PUBLIC_ pada variabel ini.
SUPABASE_SECRET_KEY=

# Opsional. Rahasia acak panjang untuk Vercel Cron (Vercel mengirimnya sebagai Bearer token).
CRON_SECRET=

# Integrasi bank dan QRIS. Biarkan false sampai tahap aktivasi selesai.
INTEGRASI_BANK_QRIS_AKTIF=false
